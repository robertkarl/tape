# 2 minutes after boot, then every 15 minutes. Cheap when there is nothing new:
# it reads the newest manifest per host and skips blobs already indexed by hash.
[Unit]
Description=Run tape ingest every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=1min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
